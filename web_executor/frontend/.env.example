# API Configuration
# Development: http://localhost:8000/api/v1
# Production: Update with your EC2 public IP or domain
# Example: http://YOUR_EC2_IP:8000/api/v1 or https://api.your-domain.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend URL for Vite Proxy (Development only - base URL without /api/v1)
# This is used by Vite dev server proxy configuration
VITE_BACKEND_URL=http://localhost:8000

# Server Configuration
VITE_PORT=5173

# Data Range Configuration (Backend available data)
VITE_DATA_START_DATE=2025-10-18
VITE_DATA_END_DATE=2025-10-30

# App Configuration
VITE_APP_NAME=Finance Portfolio
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_RAG_CHAT=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_EXPORT=true

# API Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# Pagination Defaults
VITE_DEFAULT_PAGE_SIZE=50
VITE_MAX_PAGE_SIZE=100
