# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Server Configuration
VITE_PORT=5173

# Data Range Configuration (Backend available data)
VITE_DATA_START_DATE=2025-10-18
VITE_DATA_END_DATE=2025-10-30

# App Configuration
VITE_APP_NAME=Finance Portfolio
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_RAG_CHAT=false
