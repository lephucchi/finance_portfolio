# ====== AWS CONFIGURATION ======
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-southeast-1
AWS_REGION=ap-southeast-1
S3_BUCKET=your_s3_bucket_name
AWS_BUCKET_NAME=your_s3_bucket_name

# ====== CORS CONFIGURATION ======
# Comma-separated list of allowed origins
# Development: Use localhost URLs
# Production: Update with your actual domain/IP
# Example: https://your-domain.com,http://your-ec2-ip:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173

# ====== ATHENA CONFIGURATION ======
ATHENA_DATABASE=your_athena_database

# ====== SUPABASE CONFIGURATION ======
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ====== APP CONFIGURATION (Optional) ======
# DEBUG=True
# ENVIRONMENT=development
# LOG_LEVEL=INFO

# ====== RAG CONFIGURATION ======
RAG_ENABLED=True
RAG_MODEL_NAME=keepitreal/vietnamese-sbert
RAG_FAISS_INDEX_PATH=data/rag/faiss_index.bin
RAG_METADATA_PATH=data/rag/metadata.json
RAG_EMBEDDINGS_PATH=data/rag/embeddings.npy
RAG_TOP_K=5

# ====== MCP CONFIGURATION ======
MCP_ENABLED=True
MCP_SERVER_PORT=8001

# ====== GEMINI API (Optional - for demo without user keys) ======
# DEFAULT_GEMINI_API_KEY=your_default_gemini_api_key_for_demo
ALLOW_USER_API_KEYS=True
