version: '3.8'

services:
  api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: finance-api
    ports:
      - "8000:8000"
    environment:
      DEBUG: "false"
      ENVIRONMENT: "production"
      AWS_REGION: "${AWS_REGION}"
      ATHENA_DATABASE: "${ATHENA_DATABASE}"
      SUPABASE_URL: "${SUPABASE_URL}"
    env_file:
      - .env
    volumes:
      - ./logs:/app/logs
    restart: unless-stopped
    networks:
      - finance_network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

networks:
  finance_network:
    driver: bridge
