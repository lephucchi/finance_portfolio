# AWS Configuration for S3 upload
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET=bankanalystportfolio

# Airflow Environment Configuration
# Airflow User ID (important for file permissions)
AIRFLOW_UID=50000

# Airflow Web UI Credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin123

# Project Directory (usually current directory)
AIRFLOW_PROJ_DIR=.

# Database Configuration (using defaults)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# S3 Bucket Configuration
S3_BUCKET_NAME=bankanalystportfolio

# Pipeline Configuration
MAX_RETRY_ATTEMPTS=2
PIPELINE_TIMEOUT_HOURS=4

# Logging Level
AIRFLOW_LOGGING_LEVEL=INFO

# Additional Environment Variables
PYTHONPATH=/opt/airflow/finance_portfolio

# Optional: Other configurations
# VIETSTOCK_API_KEY=your_vietstock_api_key_if_needed